<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <!-- 🟢 Mengunci zoom dan skala agar pas di layar handphone -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>SIKIOS - Pendaftaran Akun Baru</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        /* 🟢 Mengunci lebar maksimal agar tidak bisa digeser ke samping */
        html, body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            width: 100%;
            max-width: 100vw;
            overflow-x: hidden;
            margin: 0;
            padding: 0;
        }

        /* 🟢 TRIK UNTUK MENYEMBUNYIKAN SCROLLBAR */
        .hide-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .hide-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        /* EFEK SPLIT HOVER DARKEN */
        .split-panel {
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
        }

        .split-panel::after {
            content: '';
            position: absolute;
            inset: 0;
            background-color: rgba(15, 23, 42, 0.75);
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.5s ease;
            z-index: 30;
        }

        @media (min-width: 768px) {
            .split-container:hover .split-panel:not(:hover)::after {
                opacity: 1;
            }
            .split-container:hover .split-panel:hover {
                z-index: 40;
            }
        }
    </style>
</head>
<body class="bg-slate-900 min-h-screen w-full antialiased select-none">

    <!-- Toast Notification Container -->
    <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col gap-3 max-w-sm w-full pointer-events-none"></div>

    <!-- Layout Container (Split Screen Full) -->
    <div class="split-container w-full min-h-screen flex flex-col md:flex-row bg-slate-900">

        <!-- ========================================== -->
        <!-- SISI KIRI: INFORMASI / BANNER SIKIOS       -->
        <!-- ========================================== -->
        <div class="split-panel hide-scrollbar w-full md:w-1/2 p-6 sm:p-14 lg:p-16 flex flex-col justify-between relative text-white bg-gradient-to-br from-[#990026] via-[#800020] to-[#590016]">
            
            <!-- Ornamen Dekorasi -->
            <div class="absolute -right-20 -bottom-20 w-[450px] h-[450px] rounded-full border border-white/10 pointer-events-none"></div>
            <div class="absolute -right-40 -bottom-40 w-[650px] h-[650px] rounded-full border border-white/10 pointer-events-none"></div>

            <!-- Header Logo SIKIOS -->
            <div class="relative z-10 flex items-center gap-3">
                <div class="w-12 h-12 sm:w-14 sm:h-14 bg-white/10 backdrop-blur-md rounded-2xl flex items-center justify-center border border-white/20 shadow-inner">
                    <i class="fa-solid fa-shop text-xl sm:text-2xl text-white"></i>
                </div>
                <div>
                    <h3 class="text-xl sm:text-2xl font-black tracking-tight leading-none">SIKIOS</h3>
                    <p class="text-xs text-rose-200 font-medium">Smart Kios</p>
                </div>
            </div>

            <!-- Konten Tengah -->
            <div class="relative z-10 py-8 space-y-6 max-w-xl">
                <div>
                    <h1 class="text-2xl sm:text-4xl font-black tracking-tight leading-tight mb-2">
                        Bergabung dengan SIKIOS
                    </h1>
                    <p class="text-rose-100/90 text-xs sm:text-sm leading-relaxed">
                        Daftarkan akun kasir atau staf toko Anda untuk mulai mengelola inventaris, transaksi penjualan, dan laporan keuangan dengan mudah.
                    </p>
                </div>

                <div class="space-y-3 sm:space-y-4">
                    <div class="flex items-start gap-3 bg-black/25 backdrop-blur-md p-3.5 rounded-2xl border border-white/10">
                        <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-xl bg-white/20 text-white flex items-center justify-center font-black text-xs sm:text-sm flex-shrink-0 mt-0.5">
                            <i class="fa-solid fa-shield-halved text-xs"></i>
                        </div>
                        <div>
                            <h4 class="font-bold text-xs sm:text-sm text-white">Akses Terproteksi</h4>
                            <p class="text-[11px] sm:text-xs text-rose-100/80 leading-relaxed">Setiap akun baru akan disesuaikan hak aksesnya untuk menjaga keamanan data toko.</p>
                        </div>
                    </div>

                    <div class="flex items-start gap-3 bg-black/25 backdrop-blur-md p-3.5 rounded-2xl border border-white/10">
                        <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-xl bg-white/20 text-white flex items-center justify-center font-black text-xs sm:text-sm flex-shrink-0 mt-0.5">
                            <i class="fa-solid fa-bolt text-xs"></i>
                        </div>
                        <div>
                            <h4 class="font-bold text-xs sm:text-sm text-white">Manajemen Real-Time</h4>
                            <p class="text-[11px] sm:text-xs text-rose-100/80 leading-relaxed">Sinkronisasi data stok barang dan transaksi kasir langsung aktif secara otomatis.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bottom Copyright -->
            <div class="relative z-10 text-xs text-rose-200/70 font-medium pt-4">
                &copy; 2026 SIKIOS POS System. All rights reserved.
            </div>
        </div>

        <!-- ========================================== -->
        <!-- SISI KANAN: FORM REGISTER                  -->
        <!-- ========================================== -->
        <div class="split-panel w-full md:w-1/2 p-6 sm:p-16 lg:p-24 flex flex-col justify-between bg-white z-20">
            
            <!-- Top Brand Title -->
            <div class="flex items-center justify-between">
                <span class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">SIKIOS</span>
                <a href="/login" class="text-xs font-bold text-slate-600 hover:text-slate-900 transition">
                    <i class="fa-solid fa-arrow-left mr-1"></i> Kembali Login
                </a>
            </div>

            <!-- Form Content Header -->
            <div class="py-8 max-w-md w-full mx-auto space-y-6">
                <div>
                    <h2 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight mb-2">Buat Akun Baru</h2>
                    <p class="text-xs sm:text-sm text-slate-400 font-semibold">
                        Lengkapi formulir di bawah untuk mendaftarkan akun SIKIOS
                    </p>
                </div>

                <!-- Form Register -->
                <form id="registerForm" onsubmit="handleRegister(event)" class="space-y-4">
                    
                    <!-- Input Nama Lengkap -->
                    <div class="space-y-1">
                        <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider">Nama Lengkap</label>
                        <input type="text" id="fullname" required placeholder="Masukkan nama lengkap" 
                               class="w-full bg-slate-50 border-b-2 border-slate-200 px-3 py-3 text-sm font-semibold text-slate-800 focus:outline-none focus:border-slate-900 focus:bg-slate-100/80 transition duration-200">
                    </div>

                    <!-- Input Username -->
                    <div class="space-y-1">
                        <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider">Username</label>
                        <input type="text" id="username" required placeholder="Buat username unik" 
                               class="w-full bg-slate-50 border-b-2 border-slate-200 px-3 py-3 text-sm font-semibold text-slate-800 focus:outline-none focus:border-slate-900 focus:bg-slate-100/80 transition duration-200">
                    </div>

                    <!-- Input Password -->
                    <div class="space-y-1">
                        <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider">Password</label>
                        <input type="password" id="password" required placeholder="••••••••" 
                               class="w-full bg-slate-50 border-b-2 border-slate-200 px-3 py-3 text-sm font-semibold text-slate-800 focus:outline-none focus:border-slate-900 focus:bg-slate-100/80 transition duration-200">
                    </div>

                    <!-- Konfirmasi Password -->
                    <div class="space-y-1">
                        <label class="block text-xs font-bold text-slate-600 uppercase tracking-wider">Konfirmasi Password</label>
                        <input type="password" id="confirmPassword" required placeholder="••••••••" 
                               class="w-full bg-slate-50 border-b-2 border-slate-200 px-3 py-3 text-sm font-semibold text-slate-800 focus:outline-none focus:border-slate-900 focus:bg-slate-100/80 transition duration-200">
                    </div>

                    <!-- Button Register Now -->
                    <button type="submit" id="btnSubmit"
                            class="w-full bg-slate-900 hover:bg-black text-white font-bold py-3.5 rounded-xl shadow-xl shadow-slate-900/10 active:scale-[0.99] transition duration-200 text-sm mt-2 flex items-center justify-center gap-2">
                        <span>Register Now</span>
                    </button>

                </form>

                <!-- Footer Helper Text -->
                <div class="text-center pt-1">
                    <p class="text-xs text-slate-400 font-medium">
                        Sudah punya akun? <a href="/login" class="text-slate-900 font-bold underline">Login di sini</a>
                    </p>
                </div>
            </div>

            <div class="text-[11px] text-slate-400 font-medium text-center md:text-left pt-6">
                Versi Aplikasi 2.0 (Stable release)
            </div>

        </div>

    </div>

    <!-- Script API Handler Register -->
    <script>
        function showToast(title = 'Notifikasi', message = '', type = 'error') {
            const container = document.getElementById('toast-container');
            if (!container) return;

            const toast = document.createElement('div');
            toast.className = `pointer-events-auto flex items-center gap-3 p-3.5 rounded-2xl bg-white text-slate-800 border border-slate-200 shadow-xl backdrop-blur-md transform transition-all duration-300 translate-y-[-12px] opacity-0 scale-95`;
            toast.innerHTML = `
                <div class="w-9 h-9 rounded-xl ${type === 'error' ? 'bg-rose-500' : 'bg-emerald-500'} text-white flex items-center justify-center font-black flex-shrink-0">
                    <i class="fa-solid ${type === 'error' ? 'fa-xmark' : 'fa-check'} text-xs"></i>
                </div>
                <div class="flex-1 min-w-0">
                    <h4 class="font-black text-xs text-slate-900">${title}</h4>
                    <p class="text-xs text-slate-500 font-medium line-clamp-1">${message}</p>
                </div>
            `;
            container.appendChild(toast);
            requestAnimationFrame(() => {
                toast.classList.remove('translate-y-[-12px]', 'opacity-0', 'scale-95');
                toast.classList.add('translate-y-0', 'opacity-100', 'scale-100');
            });
            setTimeout(() => toast.remove(), 4000);
        }

        async function handleRegister(e) {
            e.preventDefault();
            const btn = document.getElementById('btnSubmit');
            const fullname = document.getElementById('fullname').value.trim();
            const username = document.getElementById('username').value.trim();
            const password = document.getElementById('password').value.trim();
            const confirmPassword = document.getElementById('confirmPassword').value.trim();

            // Validasi kecocokan password
            if (password !== confirmPassword) {
                showToast('Validasi Gagal', 'Konfirmasi password tidak cocok!', 'error');
                return;
            }

            btn.disabled = true;
            btn.innerHTML = `<i class="fa-solid fa-circle-notch animate-spin text-xs"></i> <span>Memproses Mendaftarkan...</span>`;

            try {
                const res = await fetch('/api/register', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ fullname, username, password })
                });

                const result = await res.json();

                if (result.success) {
                    showToast('Berhasil', 'Registrasi sukses! Mengalihkan ke halaman login...', 'success');
                    setTimeout(() => {
                        window.location.href = '/login';
                    }, 1000);
                } else {
                    showToast('Gagal Registrasi', result.message || 'Terjadi kesalahan pada sistem', 'error');
                    btn.disabled = false;
                    btn.innerHTML = `<span>Register Now</span>`;
                }
            } catch (err) {
                console.error('Register error:', err);
                showToast('Error Server', 'Tidak dapat terhubung ke server backend.', 'error');
                btn.disabled = false;
                btn.innerHTML = `<span>Register Now</span>`;
            }
        }
    </script>
</body>
</html>