<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <!-- 🟢 Mengunci skala viewport agar tidak otomatis zoom saat mengetik -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>SIKIOS - Data Barang</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        /* 🟢 Memaksa ukuran font input minimal 16px agar browser HP tidak auto-zoom */
        input[type="text"], input[type="number"], input[type="search"], select, textarea {
            font-size: 16px !important;
        }
    </style>
</head>
<body class="bg-slate-100 font-sans antialiased min-h-screen">

    <!-- Toast Container -->
    <div id="toast-container" class="fixed top-5 right-5 z-40 flex flex-col gap-3 max-w-sm w-full pointer-events-none"></div>

    <div class="flex h-screen overflow-hidden">

        <!-- ==================== 1. SIDEBAR DESKTOP ==================== -->
        <aside class="hidden md:flex md:w-64 flex-col bg-white border-r border-slate-100 p-5 text-slate-700 h-screen sticky top-0 flex-shrink-0">
            <div class="text-2xl font-black text-[#800020] mb-6 flex items-center gap-3 tracking-wide px-1">
                <i class="fa-solid fa-shop text-2xl"></i> SIKIOS
            </div>

            <nav class="space-y-0.5 font-bold text-sm overflow-y-auto flex-1">
                <a href="/dashboard" class="flex items-center gap-3 px-3.5 py-2 text-slate-700 hover:bg-rose-50 hover:text-[#800020] rounded-xl transition">
                    <i class="fa-solid fa-chart-pie w-5 text-base"></i> Dashboard
                </a>
                <a href="/sales" class="flex items-center gap-3 px-3.5 py-2 text-slate-700 hover:bg-rose-50 hover:text-[#800020] rounded-xl transition">
                    <i class="fa-solid fa-cash-register w-5 text-base"></i> Kasir / POS
                </a>
                <a href="/products" class="flex items-center gap-3 px-3.5 py-2 bg-[#800020]/10 text-[#800020] rounded-xl font-extrabold">
                    <i class="fa-solid fa-boxes-stacked w-5 text-base"></i> Data Barang
                </a>
                <a href="/cash-flow" class="flex items-center gap-3 px-3.5 py-2 text-slate-700 hover:bg-rose-50 hover:text-[#800020] rounded-xl transition">
                    <i class="fa-solid fa-wallet w-5 text-base"></i> Buku Kas
                </a>
                <a href="/receivables" class="flex items-center gap-3 px-3.5 py-2 text-slate-700 hover:bg-rose-50 hover:text-[#800020] rounded-xl transition">
                    <i class="fa-solid fa-hand-holding-dollar w-5 text-base"></i> Piutang Konsumen
                </a>
                <a href="/debts" class="flex items-center gap-3 px-3.5 py-2 text-slate-700 hover:bg-rose-50 hover:text-[#800020] rounded-xl transition">
                    <i class="fa-solid fa-file-invoice-dollar w-5 text-base"></i> Hutang Supplier
                </a>
                <a href="/reports" class="flex items-center gap-3 px-3.5 py-2 text-slate-700 hover:bg-rose-50 hover:text-[#800020] rounded-xl transition">
                    <i class="fa-solid fa-chart-line w-5 text-base"></i> Laporan
                </a>
            </nav>

            <div class="mt-auto pt-3 border-t border-slate-200/60 flex items-center justify-between gap-2">
                <div class="flex items-center gap-2.5 overflow-hidden px-1">
                    <div id="user-avatar" class="w-8 h-8 rounded-full bg-[#800020] text-white font-bold flex items-center justify-center text-xs flex-shrink-0">
                        <%= typeof user !== 'undefined' && user.name ? user.name.substring(0,2).toUpperCase() : 'AD' %>
                    </div>
                    <div class="truncate">
                        <h4 id="user-name" class="text-xs font-extrabold text-slate-900 leading-tight truncate">
                            <%= typeof user !== 'undefined' && user.name ? user.name : 'Admin Kasir' %>
                        </h4>
                        <p id="user-role" class="text-[10px] text-slate-400 font-semibold">
                            <%= typeof user !== 'undefined' && user.role ? user.role : 'Active Account' %>
                        </p>
                        <!-- Tombol Edit Profil Desktop -->
                        <button onclick="openProfileModal()" class="text-[10px] text-[#800020] hover:underline font-bold mt-0.5 block cursor-pointer">
                            <i class="fa-solid fa-user-pen mr-0.5"></i> Edit Profil
                        </button>
                    </div>
                </div>
                <a href="/logout" title="Logout" class="w-8 h-8 rounded-lg bg-rose-50 hover:bg-[#800020] text-[#800020] hover:text-white transition flex items-center justify-center cursor-pointer flex-shrink-0 text-xs font-bold">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                </a>
            </div>
        </aside>

        <!-- ==================== 2. MOBILE HAMBURGER DRAWER ==================== -->
        <div id="drawer-backdrop" onclick="toggleMobileMenu()" class="fixed inset-0 bg-slate-950/60 backdrop-blur-sm z-50 hidden opacity-0 transition-opacity duration-300 md:hidden"></div>
        <aside id="drawer-menu" class="fixed top-0 left-0 bottom-0 w-72 bg-white border-r border-slate-200 text-slate-800 z-50 transform -translate-x-full transition-transform duration-300 ease-in-out flex flex-col p-5 shadow-2xl md:hidden">
            <div class="flex items-center justify-between pb-4 mb-3 border-b border-slate-100">
                <div class="text-xl font-black text-[#800020] flex items-center gap-2 tracking-wide">
                    <i class="fa-solid fa-shop text-xl"></i> SIKIOS
                </div>
                <button type="button" onclick="toggleMobileMenu()" class="w-8 h-8 rounded-full hover:bg-slate-100 text-slate-400 hover:text-slate-800 flex items-center justify-center transition text-lg font-bold cursor-pointer">&times;</button>
            </div>
            <nav class="space-y-0.5 font-bold text-sm text-slate-700 overflow-y-auto flex-1">
                <a href="/dashboard" class="flex items-center justify-between p-2.5 hover:bg-rose-50 hover:text-[#800020] rounded-xl transition"><span><i class="fa-solid fa-chart-pie w-6"></i> Dashboard</span><i class="fa-solid fa-chevron-right text-xs opacity-40"></i></a>
                <a href="/sales" class="flex items-center justify-between p-2.5 hover:bg-rose-50 hover:text-[#800020] rounded-xl transition"><span><i class="fa-solid fa-cash-register w-6"></i> Kasir / POS</span><i class="fa-solid fa-chevron-right text-xs opacity-40"></i></a>
                <a href="/products" class="flex items-center justify-between p-2.5 bg-[#800020]/10 text-[#800020] rounded-xl transition"><span><i class="fa-solid fa-boxes-stacked w-6"></i> Data Barang</span><i class="fa-solid fa-chevron-right text-xs"></i></a>
                <a href="/cash-flow" class="flex items-center justify-between p-2.5 hover:bg-rose-50 hover:text-[#800020] rounded-xl transition"><span><i class="fa-solid fa-wallet w-6"></i> Buku Kas</span><i class="fa-solid fa-chevron-right text-xs opacity-40"></i></a>
                <a href="/receivables" class="flex items-center justify-between p-2.5 hover:bg-rose-50 hover:text-[#800020] rounded-xl transition"><span><i class="fa-solid fa-hand-holding-dollar w-6"></i> Piutang Konsumen</span><i class="fa-solid fa-chevron-right text-xs opacity-40"></i></a>
                <a href="/debts" class="flex items-center justify-between p-2.5 hover:bg-rose-50 hover:text-[#800020] rounded-xl transition"><span><i class="fa-solid fa-file-invoice-dollar w-6"></i> Hutang Supplier</span><i class="fa-solid fa-chevron-right text-xs opacity-40"></i></a>
                <a href="/reports" class="flex items-center justify-between p-2.5 hover:bg-rose-50 hover:text-[#800020] rounded-xl transition"><span><i class="fa-solid fa-chart-line w-6"></i> Laporan</span><i class="fa-solid fa-chevron-right text-xs opacity-40"></i></a>
            </nav>

            <div class="mt-auto pt-3 border-t border-slate-100 flex items-center justify-between gap-2">
                <div class="flex items-center gap-2.5 overflow-hidden">
                    <div id="mobile-user-avatar" class="w-9 h-9 rounded-full bg-[#800020] text-white font-bold flex items-center justify-center text-xs flex-shrink-0">
                        <%= typeof user !== 'undefined' && user.name ? user.name.substring(0,2).toUpperCase() : 'AD' %>
                    </div>
                    <div class="truncate">
                        <h4 id="mobile-user-name" class="text-xs font-extrabold text-slate-900 leading-tight truncate">
                            <%= typeof user !== 'undefined' && user.name ? user.name : 'Admin Kasir' %>
                        </h4>
                        <p id="mobile-user-role" class="text-[10px] text-slate-400 font-semibold">
                            <%= typeof user !== 'undefined' && user.role ? user.role : 'Active Account' %>
                        </p>
                        <!-- Tombol Edit Profil Mobile -->
                        <button onclick="openProfileModal()" class="text-[10px] text-[#800020] hover:underline font-bold mt-0.5 block cursor-pointer">
                            <i class="fa-solid fa-user-pen mr-0.5"></i> Edit Profil
                        </button>
                    </div>
                </div>
                <a href="/logout" title="Logout" class="w-9 h-9 rounded-lg bg-rose-50 hover:bg-[#800020] text-[#800020] hover:text-white transition flex items-center justify-center cursor-pointer flex-shrink-0 text-xs font-bold">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                </a>
            </div>
        </aside>

        <!-- ==================== 3. KONTEN UTAMA DATA BARANG ==================== -->
        <main class="flex-1 w-full p-4 md:p-6 flex flex-col h-screen overflow-hidden">
            
            <div class="flex-shrink-0">
                <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-4 mb-6">
                    <div class="flex items-center gap-3">
                        <button type="button" onclick="toggleMobileMenu()" class="md:hidden w-10 h-10 rounded-xl bg-slate-900 text-white flex items-center justify-center shadow-md cursor-pointer">
                            <i class="fa-solid fa-bars text-base"></i>
                        </button>
                        <div>
                            <h1 class="font-black text-slate-900 text-2xl tracking-tight">Manajemen Data Barang</h1>
                            <p class="text-xs text-slate-500 font-medium">Kelola stok produk, harga beli, dan harga jual toko.</p>
                        </div>
                    </div>
                    <button onclick="openProductModal()" class="bg-slate-900 hover:bg-blue-950 text-white text-xs font-bold px-4 py-2.5 rounded-xl shadow-md transition flex items-center gap-2 self-start sm:self-auto cursor-pointer">
                        <i class="fa-solid fa-plus text-white"></i>
                        <span>Tambah Barang</span>
                    </button>
                </div>

                <!-- Search Bar & Total Barang -->
                <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm mb-4 flex flex-col sm:flex-row gap-3 justify-between items-center">
                    <div class="relative w-full sm:w-80">
                        <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3.5 text-slate-400 text-xs"></i>
                        <input type="text" id="search-product" onkeyup="filterProductTable()" placeholder="Cari nama barang..." class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-3 py-2.5 text-base font-semibold text-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-800">
                    </div>
                    <div class="text-xs font-bold text-slate-500 self-end sm:self-auto">
                        Total: <span id="product-total-count" class="text-slate-900 font-black">0</span> Barang
                    </div>
                </div>
            </div>

            <div class="flex-1 min-h-0 bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden flex flex-col mb-4">
                <div class="overflow-y-auto flex-1">
                    <table class="w-full text-left text-xs text-slate-600">
                        <thead class="bg-slate-900 text-white uppercase font-extrabold border-b border-slate-800 sticky top-0 z-10">
                            <tr>
                                <th class="py-3.5 px-4">Nama Barang</th>
                                <th class="py-3.5 px-4">Kategori / Jenis</th>
                                <th class="py-3.5 px-4">Harga Beli</th>
                                <th class="py-3.5 px-4">Harga Jual</th>
                                <th class="py-3.5 px-4 text-center">Stok</th>
                                <th class="py-3.5 px-4 text-center">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="product-table-body" class="divide-y divide-slate-100 font-medium">
                            <tr>
                                <td colspan="6" class="py-8 text-center text-slate-400">Memuat data barang...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </main>
    </div>

    <!-- ==================== 4. MODAL EDIT PROFIL & PASSWORD ==================== -->
    <div id="profileModal" class="fixed inset-0 bg-slate-950/60 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl relative">
            <div class="flex justify-between items-center mb-4 pb-2 border-b border-slate-100">
                <h3 class="text-base font-black text-slate-900 flex items-center gap-2">
                    <i class="fa-solid fa-user-gear text-[#800020]"></i> Pengaturan Akun
                </h3>
                <button type="button" onclick="closeProfileModal()" class="w-8 h-8 rounded-full hover:bg-slate-100 text-slate-400 hover:text-slate-800 flex items-center justify-center transition text-lg font-bold cursor-pointer">&times;</button>
            </div>
            
            <!-- Form 1: Ubah Nama -->
            <div class="mb-5">
                <h4 class="text-xs font-extrabold text-slate-700 uppercase tracking-wider mb-2">Ubah Nama Profil</h4>
                <form onsubmit="updateProfileName(event)" class="space-y-2.5">
                    <div>
                        <label class="block text-xs text-slate-500 font-semibold mb-1">Nama Lengkap Baru</label>
                        <input type="text" id="newNameInput" class="w-full border border-slate-200 rounded-xl px-3 py-2.5 text-base sm:text-xs focus:outline-none focus:ring-2 focus:ring-[#800020]" required>
                    </div>
                    <button type="submit" class="bg-[#800020] text-white text-xs font-bold px-4 py-2.5 rounded-xl hover:bg-red-900 transition w-full cursor-pointer shadow-sm">
                        Simpan Nama Baru
                    </button>
                </form>
            </div>

            <hr class="my-4 border-slate-100">

            <!-- Form 2: Ubah Password -->
            <div>
                <h4 class="text-xs font-extrabold text-slate-700 uppercase tracking-wider mb-2">Ganti Password</h4>
                <form onsubmit="updatePassword(event)" class="space-y-2.5">
                    <div>
                        <label class="block text-xs text-slate-500 font-semibold mb-1">Password Lama</label>
                        <input type="password" id="currentPasswordInput" class="w-full border border-slate-200 rounded-xl px-3 py-2.5 text-base sm:text-xs focus:outline-none focus:ring-2 focus:ring-[#800020]" required>
                    </div>
                    <div>
                        <label class="block text-xs text-slate-500 font-semibold mb-1">Password Baru</label>
                        <input type="password" id="newPasswordInput" class="w-full border border-slate-200 rounded-xl px-3 py-2.5 text-base sm:text-xs focus:outline-none focus:ring-2 focus:ring-[#800020]" required>
                    </div>
                    <button type="submit" class="bg-slate-900 text-white text-xs font-bold px-4 py-2.5 rounded-xl hover:bg-slate-800 transition w-full cursor-pointer shadow-sm">
                        Ubah Password
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- ==================== 5. MODAL TAMBAH / EDIT BARANG ==================== -->
    <div id="product-modal" class="fixed inset-0 bg-slate-950/70 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden flex flex-col relative z-50 pointer-events-auto">
            
            <div class="p-4 border-b border-slate-100 flex justify-between items-center bg-slate-900 text-white">
                <h3 id="modal-title" class="font-black text-sm flex items-center gap-2">
                    <i class="fa-solid fa-box text-white"></i> Tambah Barang Baru
                </h3>
                <button type="button" onclick="closeProductModal()" class="text-slate-400 hover:text-white font-bold text-lg cursor-pointer px-2">&times;</button>
            </div>

            <form id="productForm" onsubmit="saveProduct(event)" class="p-5 space-y-4 bg-white">
                <input type="hidden" id="product-id">

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Nama Barang *</label>
                    <input type="text" id="product-name" required placeholder="Contoh: Aqua 600ml" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 text-base font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900">
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Kategori / Jenis Barang *</label>
                    <input type="text" id="product-category" required placeholder="Contoh: Minuman / Sembako" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 text-base font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900">
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Harga Beli (Rp)</label>
                        <input type="number" id="product-purchase-price" placeholder="0" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 text-base font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Harga Jual (Rp) *</label>
                        <input type="number" id="product-selling-price" required placeholder="0" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 text-base font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Jumlah Stok *</label>
                    <input type="number" id="product-stock" required placeholder="0" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 text-base font-semibold text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900">
                </div>

                <div class="pt-4 border-t border-slate-100 flex gap-2 justify-end">
                    <button type="button" onclick="closeProductModal()" class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition cursor-pointer">Batal</button>
                    <button type="submit" id="btnSaveProduct" class="px-5 py-2.5 bg-slate-900 hover:bg-blue-950 text-white text-xs font-bold rounded-xl shadow-md transition cursor-pointer">Simpan Barang</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Script Handling Engine -->
    <script>
        let productList = [];

        function toggleMobileMenu() {
            const drawer = document.getElementById('drawer-menu');
            const backdrop = document.getElementById('drawer-backdrop');
            if (!drawer || !backdrop) return;
            const isHidden = drawer.classList.contains('-translate-x-full');
            if (isHidden) {
                backdrop.classList.remove('hidden');
                requestAnimationFrame(() => {
                    backdrop.classList.add('opacity-100');
                    backdrop.classList.remove('opacity-0');
                    drawer.classList.remove('-translate-x-full');
                });
            } else {
                drawer.classList.add('-translate-x-full');
                backdrop.classList.remove('opacity-100');
                backdrop.classList.add('opacity-0');
                setTimeout(() => {
                    backdrop.classList.add('hidden');
                }, 300);
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            fetchCurrentUser();
            loadProducts();
        });

        // --- HANDLER MODAL PROFIL & PASSWORD ---
        function openProfileModal() {
            const modal = document.getElementById('profileModal');
            if (modal) {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
                const currentName = document.getElementById('user-name')?.innerText || '';
                document.getElementById('newNameInput').value = currentName.trim();
            }
        }

        function closeProfileModal() {
            const modal = document.getElementById('profileModal');
            if (modal) {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }
        }

        async function updateProfileName(e) {
            e.preventDefault();
            const newName = document.getElementById('newNameInput').value;

            try {
                const res = await fetch('/api/auth/update-profile', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name: newName })
                });
                const data = await res.json();

                if (data.success) {
                    alert(data.message);
                    closeProfileModal();
                    fetchCurrentUser();
                } else {
                    alert(data.message);
                }
            } catch (err) {
                alert('Terjadi kesalahan saat memperbarui nama.');
            }
        }

        async function updatePassword(e) {
            e.preventDefault();
            const current_password = document.getElementById('currentPasswordInput').value;
            const new_password = document.getElementById('newPasswordInput').value;

            try {
                const res = await fetch('/api/auth/update-password', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ current_password, new_password })
                });
                const data = await res.json();

                if (data.success) {
                    alert(data.message);
                    closeProfileModal();
                    document.getElementById('currentPasswordInput').value = '';
                    document.getElementById('newPasswordInput').value = '';
                } else {
                    alert(data.message);
                }
            } catch (err) {
                alert('Terjadi kesalahan saat mengubah password.');
            }
        }

        async function fetchCurrentUser() {
            try {
                const res = await fetch('/api/auth/me');
                const data = await res.json();
                if (data && data.name) {
                    const initials = data.name.substring(0, 2).toUpperCase();
                    document.getElementById('user-name').innerText = data.name;
                    document.getElementById('user-role').innerText = data.role || 'Active Account';
                    document.getElementById('user-avatar').innerText = initials;
                    document.getElementById('mobile-user-name').innerText = data.name;
                    document.getElementById('mobile-user-role').innerText = data.role || 'Active Account';
                    document.getElementById('mobile-user-avatar').innerText = initials;
                }
            } catch (e) {}
        }

        async function loadProducts() {
            const tbody = document.getElementById('product-table-body');
            try {
                const res = await fetch('/api/products');
                const data = await res.json();
                productList = Array.isArray(data) ? data : (data.data || []);
                document.getElementById('product-total-count').innerText = productList.length;
                renderProductTable(productList);
            } catch (err) {
                tbody.innerHTML = `<tr><td colspan="6" class="py-6 text-center text-rose-500 font-bold">Gagal mengambil data produk.</td></tr>`;
            }
        }

        function renderProductTable(data) {
            const tbody = document.getElementById('product-table-body');
            tbody.innerHTML = '';
            if (!data || data.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="py-6 text-center text-slate-400">Tidak ada data barang.</td></tr>`;
                return;
            }

            data.forEach(p => {
                const name = p.name || p.nama || p.nama_barang || 'Barang';
                const category = p.category_name || p.category || p.kategori || p.jenis || 'Umum';
                const purchasePrice = parseFloat(p.purchase_price || p.harga_beli || 0);
                const sellingPrice = parseFloat(p.selling_price || p.price || p.harga_jual || p.harga || 0);
                const stock = parseInt(p.stock || p.stok || 0);

                tbody.innerHTML += `
                    <tr class="hover:bg-slate-50 transition border-b border-slate-100">
                        <td class="py-3 px-4 font-bold text-slate-800">${name}</td>
                        <td class="py-3 px-4 text-slate-500">${category}</td>
                        <td class="py-3 px-4 text-slate-500">Rp ${purchasePrice.toLocaleString('id-ID')}</td>
                        <td class="py-3 px-4 font-bold text-slate-900">Rp ${sellingPrice.toLocaleString('id-ID')}</td>
                        <td class="py-3 px-4 text-center">
                            <span class="px-2.5 py-1 rounded-full text-[11px] font-black ${stock <= 5 ? 'bg-rose-100 text-rose-600' : 'bg-emerald-100 text-emerald-700'}">
                                ${stock} pcs
                            </span>
                        </td>
                        <td class="py-3 px-4 text-center">
                            <div class="flex items-center justify-center gap-1.5">
                                <button onclick="editProduct(${p.id})" class="p-1.5 bg-amber-50 hover:bg-amber-100 text-amber-600 rounded-lg transition cursor-pointer" title="Edit">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </button>
                                <button onclick="deleteProduct(${p.id})" class="p-1.5 bg-rose-50 hover:bg-rose-100 text-rose-600 rounded-lg transition cursor-pointer" title="Hapus">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            });
        }

        function filterProductTable() {
            const keyword = document.getElementById('search-product').value.toLowerCase();
            const filtered = productList.filter(p => {
                const name = (p.name || p.nama || p.nama_barang || '').toLowerCase();
                return name.includes(keyword);
            });
            renderProductTable(filtered);
        }

        function openProductModal() {
            document.getElementById('productForm').reset();
            document.getElementById('product-id').value = '';
            document.getElementById('modal-title').innerHTML = `<i class="fa-solid fa-box text-white"></i> Tambah Barang Baru`;
            const modal = document.getElementById('product-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            setTimeout(() => {
                document.getElementById('product-name').focus();
            }, 50);
        }

        function closeProductModal() {
            const modal = document.getElementById('product-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function editProduct(id) {
            const p = productList.find(item => item.id === id);
            if (!p) return;

            document.getElementById('product-id').value = p.id;
            document.getElementById('product-name').value = p.name || p.nama || p.nama_barang || '';
            document.getElementById('product-category').value = p.category_name || p.category || p.kategori || p.jenis || '';
            document.getElementById('product-purchase-price').value = p.purchase_price || p.harga_beli || 0;
            document.getElementById('product-selling-price').value = p.selling_price || p.price || p.harga_jual || p.harga || 0;
            document.getElementById('product-stock').value = p.stock || p.stok || 0;

            document.getElementById('modal-title').innerHTML = `<i class="fa-solid fa-pen-to-square text-sky-400"></i> Edit Data Barang`;
            const modal = document.getElementById('product-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            setTimeout(() => {
                document.getElementById('product-name').focus();
            }, 50);
        }

        async function saveProduct(e) {
            e.preventDefault();
            const id = document.getElementById('product-id').value;
            const nameVal = document.getElementById('product-name').value.trim();
            const categoryVal = document.getElementById('product-category').value.trim();
            const purchasePriceVal = parseFloat(document.getElementById('product-purchase-price').value) || 0;
            const sellingPriceVal = parseFloat(document.getElementById('product-selling-price').value) || 0;
            const stockVal = parseInt(document.getElementById('product-stock').value) || 0;

            const payload = {
                name: nameVal,
                nama: nameVal,
                category: categoryVal,
                category_name: categoryVal,
                kategori: categoryVal,
                jenis: categoryVal,
                purchase_price: purchasePriceVal,
                harga_beli: purchasePriceVal,
                price: sellingPriceVal,
                selling_price: sellingPriceVal,
                harga_jual: sellingPriceVal,
                stock: stockVal,
                stok: stockVal
            };

            const url = id ? `/api/products/${id}` : '/api/products';
            const method = id ? 'PUT' : 'POST';

            try {
                const res = await fetch(url, {
                    method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await res.json();
                if (res.ok || result.success) {
                    closeProductModal();
                    loadProducts();
                } else {
                    alert(result.message || 'Gagal menyimpan data barang.');
                }
            } catch (err) {
                alert('Terjadi kesalahan koneksi server.');
            }
        }

        async function deleteProduct(id) {
            if (!confirm('Apakah Anda yakin ingin menghapus barang ini?')) return;
            try {
                const res = await fetch(`/api/products/${id}`, { method: 'DELETE' });
                const result = await res.json();
                if (res.ok || result.success) {
                    loadProducts();
                } else {
                    alert(result.message || 'Gagal menghapus data barang.');
                }
            } catch (err) {
                alert('Terjadi kesalahan koneksi server.');
            }
        }
    </script>
</body>
</html>